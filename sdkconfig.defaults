CONFIG_IDF_TARGET="esp32p4"
# ESP32-P4 rev < v3.0 (v1.3 board)
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
# Flash 8 MB DIO 40 MHz
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
# PSRAM 32 MB integrated
CONFIG_SPIRAM=y
# Console on UART0 (GPIO37/38), not on USB
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_TX_GPIO=37
CONFIG_ESP_CONSOLE_UART_RX_GPIO=38
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
# TinyUSB CDC
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1

# LVGL (24-bit colour, 28 pt font for the demo)
CONFIG_LV_COLOR_DEPTH_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_USE_OS_NONE=y

# app_main draws analytically (floats, snprintf): the default 3584 B main stack is too small
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_LV_USE_OBJ_NAME=y   # needed by the code exported from the LVGL Pro Editor (lv_obj_set_name_static)
CONFIG_LV_USE_TRANSLATION=y
CONFIG_LV_USE_TJPGD=y
CONFIG_LV_USE_FS_MEMFS=y
CONFIG_LV_FS_MEMFS_LETTER=77
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_TINY_TTF=y
